{
  "id": "sdf-playground",
  "name": "SDF playground",
  "version": "1.0.0",
  "metadata": {
    "description": "Compose native distance fields, blend shapes, and fill them with a material. Remix the graph to explore the complete Sdf API.",
    "tool": {
      "schemaVersion": 1,
      "slug": "sdf-playground",
      "icon": "cube",
      "tags": [
        "shape",
        "educative"
      ],
      "timeout": 60,
      "output": "generic"
    },
    "examples": [
      {
        "name": "Default example",
        "inputs": {
          "radius": 12,
          "blend": 4
        }
      }
    ]
  },
  "nodes": [
    {
      "id": "radius",
      "type": "input",
      "position": {
        "x": 12,
        "y": 332
      },
      "data": {
        "label": "radius",
        "dataType": "number",
        "value": 12,
        "default": 12,
        "min": 2,
        "max": 24,
        "step": 1,
        "widgetType": "slider",
        "toolField": {
          "group": "Settings",
          "order": 0
        }
      }
    },
    {
      "id": "blend",
      "type": "input",
      "position": {
        "x": 12,
        "y": 12
      },
      "data": {
        "label": "blend",
        "dataType": "number",
        "value": 4,
        "default": 4,
        "min": 0,
        "max": 12,
        "step": 1,
        "widgetType": "slider",
        "toolField": {
          "group": "Settings",
          "order": 1
        }
      }
    },
    {
      "id": "field",
      "type": "code",
      "position": {
        "x": 412,
        "y": 18.66666666666667
      },
      "data": {
        "label": "Compose fields",
        "code": "type Outputs = { field: Nucleation.Sdf }; type Inputs = { radius: number; blend: number }; function generate(inputs: Inputs) { const sphere = Nucleation.Sdf.sphere(inputs.radius); const box = Nucleation.Sdf.boxShape(inputs.radius*.8,inputs.radius*.8,inputs.radius*.8,1).translate(inputs.radius,0,0); return { field: sphere.smoothUnion(box,inputs.blend) }; }",
        "contract": {
          "inputs": {
            "radius": {
              "kind": "number"
            },
            "blend": {
              "kind": "number"
            }
          },
          "outputs": {
            "field": {
              "kind": "native",
              "className": "Sdf"
            }
          }
        },
        "io": {
          "inputs": {
            "radius": {
              "type": "number"
            },
            "blend": {
              "type": "number"
            }
          },
          "outputs": {
            "field": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "fill",
      "type": "code",
      "position": {
        "x": 1152,
        "y": 18.66666666666667
      },
      "data": {
        "label": "Fill native shape",
        "code": "type Outputs = { schematic: Nucleation.Schematic; definition: {} }; type Inputs = { field: Nucleation.Sdf }; function generate(inputs: Inputs) { const schematic=Nucleation.Schematic.create('SDF blend'); Nucleation.BuildingTool.fill(schematic,inputs.field.toShape(),Nucleation.Brush.shaded(70,170,220,-1,2,1)); return { schematic, definition: JSON.parse(inputs.field.toJson()) }; }",
        "contract": {
          "inputs": {
            "field": {
              "kind": "native",
              "className": "Sdf"
            }
          },
          "outputs": {
            "schematic": {
              "kind": "schematic"
            },
            "definition": {
              "kind": "object",
              "fields": {}
            }
          }
        },
        "io": {
          "inputs": {
            "field": {
              "type": "object"
            }
          },
          "outputs": {
            "schematic": {
              "type": "schematic"
            },
            "definition": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "out-schematic",
      "type": "output",
      "position": {
        "x": 1892,
        "y": 12
      },
      "data": {
        "label": "schematic",
        "dataType": "schematic"
      }
    },
    {
      "id": "out-definition",
      "type": "output",
      "position": {
        "x": 1892,
        "y": 332
      },
      "data": {
        "label": "definition",
        "dataType": "object"
      }
    }
  ],
  "edges": [
    {
      "id": "radius-field-radius",
      "source": "radius",
      "target": "field",
      "sourceHandle": "output",
      "targetHandle": "radius"
    },
    {
      "id": "blend-field-blend",
      "source": "blend",
      "target": "field",
      "sourceHandle": "output",
      "targetHandle": "blend"
    },
    {
      "id": "field-fill-field",
      "source": "field",
      "target": "fill",
      "sourceHandle": "field",
      "targetHandle": "field"
    },
    {
      "id": "out-schematic",
      "source": "fill",
      "target": "out-schematic",
      "sourceHandle": "schematic",
      "targetHandle": "input"
    },
    {
      "id": "out-definition",
      "source": "fill",
      "target": "out-definition",
      "sourceHandle": "definition",
      "targetHandle": "input"
    }
  ]
}
