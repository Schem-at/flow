              "type": "object"
            },
            "timeMs": {
              "type": "number"
            }
          },
          "outputs": {
            "schematic": {
              "type": "schematic"
            },
            "frame": {
              "type": "object"
            },
            "durationMs": {
              "type": "number"
            }
          }
        }
      }
