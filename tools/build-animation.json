{
  "id": "build-animation",
  "name": "Construction animation",
  "version": "1.0.0",
  "metadata": {
    "description": "Record construction, apply effects, and inspect a moment in the timeline. Preview the build, play its animation, and export an animated GLB.",
    "tool": {
      "schemaVersion": 1,
      "slug": "build-animation",
      "icon": "cube",
      "tags": [
        "minecraft",
        "educative"
      ],
      "timeout": 60,
      "output": "generic"
    },
    "examples": [
