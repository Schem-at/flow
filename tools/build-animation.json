    {
      "id": "build",
      "type": "code",
      "position": {
        "x": 412,
        "y": 360.33333333333337
      },
      "data": {
        "label": "Record construction",
        "code": "type Outputs = { animation: Nucleation.BuildAnimation }; type Inputs = { count: number }; function generate(inputs: Inputs) { const animation=Nucleation.BuildAnimation.create('Animated steps'); animation.setDefaultEffect(Nucleation.AnimationEffect.dropAndPop(600,8)); animation.setStepMs(80); for(let i=0;i<inputs.count;i++) animation.setBlock(i,Math.floor(i/3),0,'minecraft:gold_block'); return { animation }; }",
        "contract": {
          "inputs": {
            "count": {
              "kind": "number"
            }
          },
          "outputs": {
            "animation": {
              "kind": "native",
              "className": "BuildAnimation"
            }
          }
        },
        "io": {
          "inputs": {
            "count": {
              "type": "number"
            }
          },
          "outputs": {
            "animation": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "sample",
      "type": "code",
      "position": {
        "x": 1152,
        "y": 47
      },
      "data": {
        "label": "Sample timeline",
        "code": "type Outputs = { schematic: Nucleation.Schematic; frame: {}; durationMs: number }; type Inputs = { animation: Nucleation.BuildAnimation; timeMs: number }; function generate(inputs: Inputs) { return { schematic: Nucleation.Schematic.fromData(Bytes.fromBase64(inputs.animation.toSchemB64())), frame: JSON.parse(inputs.animation.frameJson(inputs.timeMs)), durationMs: inputs.animation.durationMs() }; }",
        "contract": {
          "inputs": {
            "animation": {
              "kind": "native",
              "className": "BuildAnimation"
            },
            "timeMs": {
              "kind": "number"
            }
          },
          "outputs": {
            "schematic": {
              "kind": "schematic"
            },
            "frame": {
              "kind": "object",
              "fields": {}
            },
            "durationMs": {
