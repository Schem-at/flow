    {
      "id": "palette-build",
      "type": "code",
      "position": {
        "x": 732,
        "y": 12
      },
      "data": {
        "label": "Choose blocks",
        "code": "type Inputs = { palette: BlockPalette };\ntype Outputs = { palette: ResolvedPalette };\nfunction generate(inputs: Inputs): Outputs {\n  progress(0.05, 'Resolving the palette');\n  return { palette: Blocks.palette(inputs.palette) };\n}",
        "contract": {
          "inputs": {
            "palette": {
              "kind": "palette"
            }
          },
          "outputs": {
            "palette": {
              "kind": "unknown"
            }
          }
        },
        "io": {
          "inputs": {
            "palette": {
              "type": "object"
            }
          },
          "outputs": {
            "palette": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "decode",
      "type": "code",
      "position": {
        "x": 732,
        "y": 432
      },
      "data": {
        "label": "Read image",
        "code": "type Inputs = { file: ToolFile; width: number };\ntype Outputs = { image: PixelImage };\nasync function generate(inputs: Inputs): Promise<Outputs> {\n  progress(0.15, 'Reading the image');\n  return { image: await Blocks.image(inputs.file, inputs.width) };\n}",
        "contract": {
          "inputs": {
            "file": {
              "kind": "file"
            },
            "width": {
              "kind": "number"
            }
          },
          "outputs": {
            "image": {
              "kind": "unknown"
            }
          }
        },
        "io": {
          "inputs": {
            "file": {
              "type": "object"
            },
            "width": {
              "type": "number"
            }
          },
          "outputs": {
            "image": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "convert",
      "type": "code",
      "position": {
        "x": 1472,
        "y": 466
      },
      "data": {
        "label": "Map pixels to blocks",
        "code": "type Inputs = { image: PixelImage; palette: ResolvedPalette; orientation: 'wall' | 'floor'; dither: boolean };\ntype Outputs = { schematic: Schematic };\nfunction generate(inputs: Inputs): Outputs {\n  progress(0.4, 'Matching colours to blocks');\n  return { schematic: Blocks.pixelArt(inputs.image, inputs.palette, inputs.orientation, inputs.dither) };\n}",
        "contract": {
          "inputs": {
            "image": {
              "kind": "unknown"
            },
            "palette": {
              "kind": "unknown"
            },
            "orientation": {
              "kind": "enum",
              "options": [
                "wall",
                "floor"
              ]
            },
            "dither": {
              "kind": "boolean"
            }
          },
          "outputs": {
            "schematic": {
              "kind": "schematic"
            }
          }
        },
        "io": {
          "inputs": {
            "image": {
              "type": "object"
            },
            "palette": {
              "type": "object"
            },
            "orientation": {
              "type": "string",
              "options": [
                "wall",
                "floor"
              ],
              "default": "wall"
            },
            "dither": {
              "type": "boolean"
            }
          },
          "outputs": {
            "schematic": {
              "type": "schematic"
            }
          }
        }
      }
    },
    {
      "id": "measure",
      "type": "code",
      "position": {
        "x": 2212,
        "y": 779.3333333333333
      },
      "data": {
        "label": "Describe result",
        "code": "type Inputs = { schematic: Schematic };\ntype Outputs = { metadata: { dimensions: number[]; block_count: number; blocks_used: Record<string, number>; palette_size: number; placed: number } };\nfunction generate(inputs: Inputs): Outputs {\n  progress(0.9, 'Measuring the result');\n  return { metadata: Blocks.measure(inputs.schematic) };\n}",
        "contract": {
          "inputs": {
            "schematic": {
              "kind": "schematic"
            }
          },
          "outputs": {
            "metadata": {
              "kind": "object",
              "fields": {
                "dimensions": {
                  "kind": "list",
                  "of": {
                    "kind": "number"
                  }
                },
                "block_count": {
                  "kind": "number"
                },
                "blocks_used": {
                  "kind": "unknown"
                },
                "palette_size": {
                  "kind": "number"
                },
                "placed": {
                  "kind": "number"
                }
              }
            }
          }
        },
        "io": {
          "inputs": {
            "schematic": {
              "type": "schematic"
            }
          },
          "outputs": {
            "metadata": {
              "type": "object"
            }
          }
        }
      }
