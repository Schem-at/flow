    {
      "id": "transform",
      "type": "code",
      "position": {
        "x": 400,
        "y": 0
      },
      "data": {
        "code": "type Inputs = { file: ToolFile; rotate: number[] }; type Outputs = { schematic: Nucleation.Schematic };\nfunction generate(inputs: Inputs): Outputs {\n  if (inputs.rotate.length !== 3 || inputs.rotate.some((v: number) => ![0, 90, 180, 270].includes(v))) throw new Error('Rotation must be quarter turns: [x, y, z] in 0, 90, 180, 270.');\n  progress(0.3, 'Rotating');\n  const schematic = Nucleation.Schematic.fromData(Bytes.read(inputs.file));\n  if (inputs.rotate[0]) schematic.rotateSchematicX(inputs.rotate[0]);\n  if (inputs.rotate[1]) schematic.rotateSchematicY(inputs.rotate[1]);\n  if (inputs.rotate[2]) schematic.rotateSchematicZ(inputs.rotate[2]);\n  return { schematic };\n}",
        "contract": {
          "inputs": {
            "file": {
              "kind": "file"
            },
            "rotate": {
              "kind": "list",
              "of": {
                "kind": "number"
              }
            }
          },
          "outputs": {
            "schematic": {
              "kind": "schematic"
            }
          }
        },
        "io": {
          "inputs": {
            "file": {
              "type": "object"
            },
            "rotate": {
              "type": "array"
            }
          },
          "outputs": {
            "schematic": {
              "type": "schematic"
            }
          }
        }
      }
    },
