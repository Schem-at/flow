              "kind": "boolean"
            },
            "ticks": {
              "kind": "number"
            }
          },
          "outputs": {
            "schematic": {
              "kind": "schematic"
            },
            "analysis": {
              "kind": "object",
              "fields": {}
            }
          }
        },
        "io": {
