    {
      "id": "build",
      "type": "code",
      "position": {
        "x": 12,
        "y": 12
      },
      "data": {
        "label": "Build test circuit",
        "code": "type Inputs = {}; type Outputs = { world: Nucleation.TickSimulation; schematic: Nucleation.Schematic };\nfunction generate(): Outputs {\n  progress(0.2, 'Building the circuit');\n  const schematic = Nucleation.Schematic.create('Lever and lamp');\n  schematic.fillCuboid(0, 0, 0, 4, 0, 0, 'minecraft:stone');\n  schematic.setBlock(0, 1, 0, 'minecraft:lever[face=floor,facing=east,powered=false]');\n  for (let x = 1; x < 4; x++) schematic.setBlock(x, 1, 0, 'minecraft:redstone_wire[east=side,west=side,north=none,south=none,power=0]');\n  schematic.setBlock(4, 1, 0, 'minecraft:redstone_lamp[lit=false]');\n  const world = Nucleation.TickSimulation.fromSchematic(schematic, Nucleation.TickSettleMode.Placement, 0, 0, 0, '');\n  return { world, schematic };\n}",
        "contract": {
          "inputs": {},
          "outputs": {
            "world": {
              "kind": "native",
              "className": "TickSimulation"
            },
            "schematic": {
              "kind": "schematic"
            }
          }
        },
        "io": {
          "inputs": {},
          "outputs": {
            "world": {
              "type": "object"
            },
            "schematic": {
              "type": "schematic"
            }
          }
        }
      }
    },
    {
      "id": "simulate",
      "type": "code",
      "position": {
        "x": 752,
        "y": 600
      },
      "data": {
        "label": "Analyze and simulate",
        "code": "type Outputs = { schematic: Nucleation.Schematic; analysis: {} }; type Inputs = { world: Nucleation.TickSimulation; schematic: Nucleation.Schematic; powered: boolean; ticks: number };\nfunction generate(inputs: Inputs): Outputs {\n  progress(0.5, 'Simulating');\n  inputs.world.recordTimeline();\n  if (inputs.powered) inputs.world.useBlock(0, 1, 0);\n  inputs.world.run(inputs.ticks);\n  inputs.world.stopTimeline();\n  inputs.world.bakeTo(inputs.schematic);\n  return { schematic: inputs.schematic, analysis: {\n    ticks: inputs.world.tickCount(),\n    machineGraph: JSON.parse(inputs.world.machineGraphJson()),\n    activity: JSON.parse(inputs.world.timelineActivityJson()),\n    lampLit: inputs.world.getBlock(4, 1, 0).includes('lit=true'),\n  } };\n}",
        "contract": {
          "inputs": {
            "world": {
              "kind": "native",
              "className": "TickSimulation"
            },
            "schematic": {
              "kind": "schematic"
            },
