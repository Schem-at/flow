    {
      "id": "palette-build",
      "type": "code",
      "position": {
        "x": 732,
        "y": 12
      },
      "data": {
        "label": "Choose blocks",
        "code": "type Inputs = { palette: BlockPalette };\ntype Outputs = { palette: ResolvedPalette };\nfunction generate(inputs: Inputs): Outputs {\n  progress(0.05, 'Resolving the palette');\n  return { palette: Blocks.palette(inputs.palette) };\n}",
        "contract": {
          "inputs": {
            "palette": {
              "kind": "palette"
            }
          },
          "outputs": {
            "palette": {
              "kind": "unknown"
            }
          }
        },
        "io": {
          "inputs": {
            "palette": {
              "type": "object"
            }
          },
          "outputs": {
            "palette": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "convert",
      "type": "code",
      "position": {
        "x": 1472,
        "y": 1342
      },
      "data": {
        "label": "Voxelise model",
        "code": "type Inputs = { file: ToolFile; palette: ResolvedPalette; size: number; size_axis: 'longest' | 'x' | 'y' | 'z'; shell: boolean; shading: 'none' | 'directional'; light_azimuth: number; light_elevation: number; light_strength: number };\ntype Lighting = { direction: number[]; strength: number } | null;\ntype Plan = { planned_dimensions: number[]; size: number; size_axis: string; shell: boolean; shading: string; lighting: Lighting };\ntype Outputs = { schematic: Nucleation.Schematic; plan: Plan };\nfunction generate(inputs: Inputs): Outputs {\nprogress(0.1, 'Reading the model');\nconst azimuth = inputs.light_azimuth * Math.PI / 180;\nconst elevation = inputs.light_elevation * Math.PI / 180;\nconst lighting: Lighting = inputs.shading === 'directional' ? {\n  direction: [Math.sin(azimuth) * Math.cos(elevation), Math.sin(elevation), -Math.cos(azimuth) * Math.cos(elevation)],\n  strength: inputs.light_strength / 100,\n} : null;\nconst bytes = Bytes.read(inputs.file);\nconst glb = bytes[0] === 0x67 && bytes[1] === 0x6c && bytes[2] === 0x54 && bytes[3] === 0x46;\nconst text = glb ? '' : Bytes.text(bytes);\nif (!glb && !/^v\\s/m.test(text)) throw new Error('That file is neither a GLB nor an OBJ.');\nconst model = glb ? Nucleation.Voxelizer.loadGlb(bytes) : Nucleation.Voxelizer.loadObj(text);\nconst options = JSON.stringify({ target_size: inputs.size, axis: inputs.size_axis, hollow: inputs.shell, lighting, untextured_block: inputs.palette.ids[0] });\nconst plan: { dimensions: number[]; error?: string } = JSON.parse(model.planJson(options));\nif (plan.error) throw new Error(plan.error);\nprogress(0.3, 'Voxelising model');\nconst schematic = model.toSchematic(options, inputs.palette.palette, 'model');\nprogress(0.8, 'Applying block replacements');\nif (Object.keys(inputs.palette.replace).length) schematic.replaceBlocksJson(JSON.stringify(inputs.palette.replace));\nreturn { schematic, plan: { planned_dimensions: plan.dimensions, size: inputs.size, size_axis: inputs.size_axis, shell: inputs.shell, shading: inputs.shading, lighting } };\n}",
        "contract": {
          "inputs": {
            "file": {
              "kind": "file"
            },
            "palette": {
              "kind": "unknown"
            },
            "size": {
              "kind": "number"
            },
            "size_axis": {
              "kind": "enum",
              "options": [
                "longest",
                "x",
                "y",
                "z"
              ]
            },
            "shell": {
              "kind": "boolean"
            },
            "shading": {
              "kind": "enum",
              "options": [
                "none",
                "directional"
              ]
            },
            "light_azimuth": {
              "kind": "number"
            },
            "light_elevation": {
              "kind": "number"
            },
            "light_strength": {
              "kind": "number"
            }
          },
          "outputs": {
            "schematic": {
              "kind": "schematic"
            },
            "plan": {
              "kind": "object",
              "fields": {
                "planned_dimensions": {
                  "kind": "list",
                  "of": {
                    "kind": "number"
                  }
                },
                "size": {
                  "kind": "number"
                },
                "size_axis": {
                  "kind": "string"
                },
                "shell": {
                  "kind": "boolean"
                },
                "shading": {
                  "kind": "string"
                },
                "lighting": {
                  "kind": "unknown"
                }
              }
            }
          }
        },
        "io": {
          "inputs": {
            "file": {
              "type": "object"
            },
            "palette": {
              "type": "object"
            },
            "size": {
              "type": "number"
            },
            "size_axis": {
              "type": "string",
              "options": [
                "longest",
                "x",
                "y",
                "z"
              ],
              "default": "longest"
            },
            "shell": {
              "type": "boolean"
            },
            "shading": {
              "type": "string",
              "options": [
                "none",
                "directional"
              ],
              "default": "none"
            },
            "light_azimuth": {
              "type": "number"
            },
            "light_elevation": {
              "type": "number"
            },
            "light_strength": {
              "type": "number"
            }
          },
          "outputs": {
