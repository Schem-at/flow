      "data": {
        "label": "Describe result",
        "code": "type Plan = { planned_dimensions: number[]; size: number; size_axis: string; shell: boolean; shading: string; lighting: { direction: number[]; strength: number } | null };\ntype Outputs = { metadata: Plan & { dimensions: number[]; block_count: number; blocks_used: Record<string, number>; palette_size: number; placed: number } };\ntype Inputs = { schematic: Nucleation.Schematic; plan: Plan };\nfunction generate(inputs: Inputs): Outputs {\n  progress(0.9, 'Measuring the result');\n  return { metadata: { ...inputs.plan, ...Blocks.measure(inputs.schematic) } };\n}",
        "contract": {
          "inputs": {
            "schematic": {
              "kind": "schematic"
            },
            "plan": {
              "kind": "object",
              "fields": {
                "planned_dimensions": {
